{
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "0.45.2",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.4.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "5.6.3",
    "vite": "^6.0.0"
  },
  "name": "rima-supply-standalone",
  "private": true,
  "scripts": {
    "build": "bun run build:server && bun run build:client",
    "build:client": "bun x vite build client",
    "build:server": "bun build ./server/src/index.ts --target=bun --outfile=./dist/server.js --external:express --external:bun",
    "db:migrate": "bun run server/src/migrate.ts",
    "db:seed-admin": "bun run server/src/seed-admin.ts",
    "dev": "bun run server/src/index.ts",
    "dev:client": "bun x vite client",
    "start": "bun ./dist/server.js"
  },
  "type": "module",
  "version": "1.0.0"
}