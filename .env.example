# RIMA Supply — standalone environment template.
# Copy to .env and fill in before running.

# Port the server listens on (Railway sets PORT automatically).
PORT=3000

# Where the SQLite database and uploaded blobs live.
# On Railway, mount a persistent volume at /data and set DATA_DIR=/data.
DATA_DIR=./data

# Full path to the SQLite file (defaults to $DATA_DIR/app.db).
# DB_PATH=/data/app.db

# Secret for signing session cookies. GENERATE A LONG RANDOM STRING for production.
# Example: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL (used for blob links). Set to your Railway domain in production.
# BASE_URL=https://your-app.up.railway.app

# Initial admin account (only used when the users table is empty on first boot).
SEED_ADMIN_USERNAME=randy
SEED_ADMIN_PASSWORD=change-this-immediately
SEED_ADMIN_NAME=Randy Leary

# Optional: Anthropic API key enables AI-powered warehouse PDF line extraction.
# Without it, the app falls back to regex-based extraction (works, less smart).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Set to 1 to allow non-HTTPS session cookies (local dev only).
# COOKIE_SECURE=0
